<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Remote access sends the phone's TV keys to the player, which has a process of its own (see PlayerKeys).
         Only this app may send them or receive them. -->
    <permission android:name="${applicationId}.permission.REMOTE_KEYS" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.REMOTE_KEYS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates from GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Uninstalling Piume, once its settings and history are here (Android asks first; see FromPiume). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets us read every app's Watch Next entries (same permission Projectivy uses). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Dictating a title into the search box (asked for the first time someone picks Say it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Folder wallpapers: asked for only when someone picks "Choose a folder on this TV". -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Downloads into the shared Download or Movies folder (Settings → Content → Download folder): Android 9 and
         older only ask it; from Android 10 the download manager saves there without it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Granted once over adb (pm grant link.mccoy88f.zephyr android.permission.WRITE_SECURE_SETTINGS) so the app can
         re-enable its Home service: Android drops it from the enabled list whenever the app is force-stopped. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Settings screens Zephyr TV opens: resolved first, to skip the empty stubs many TVs answer with (see tryScreen). -->
        <!-- Not the accessibility, notification access or App info screens: asking for those, Play Protect took the
             app for one that hijacks permissions. They're still opened, just not resolved first. -->
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <!-- The home apps, for Android's chooser where the TV has no home app settings (see makeDefaultHome). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Piume, what Zephyr TV was: its settings and history are taken on the first start (see FromPiume). -->
        <package android:name="dev.piume" />
        <!-- Sony TVs: which external inputs have a device connected (see connectedInputs). -->
        <provider android:authorities="com.sony.dtv.tvinput.external.provider" />
        <!-- The apps that open a TV channel, to find the TV app and offer it in its setting (see TvApp). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
    </queries>

    <!-- Cleartext stays allowed: Continue Watching posters come from other apps' listings, and some give
         plain http addresses. Everything Zephyr TV asks for itself (TMDB, weather, updates) is https. -->
    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Links (see Links): ztv: and stremio:, the page shared links go to, and text shared from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ztv" />
                <data android:scheme="stremio" />
                <data android:scheme="nuvio" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mccoy88f.github.io" android:pathPrefix="/Zephyr_TV/open" />
            </intent-filter>
            <!-- The site's shared titles (/t/) and extensions, add-ons and plugins (/o/): see siteToZtv. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ztv.mccoy88f.link" android:pathPrefix="/t/" />
                <data android:scheme="https" android:host="ztv.mccoy88f.link" android:pathPrefix="/o/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Phones and tablets: an icon among their apps too (see Touch). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A shared title's poster, read by the app it's shared to (see SharedImages): not exported, readable only
             through the permission the share grants for that one picture. -->
        <provider
            android:name=".SharedImages"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The downloaded films and episodes, read by the player and by the app one is shared to (see DownloadFiles):
             not exported, readable only through the permission the share grants for that one file. -->
        <provider
            android:name=".DownloadFiles"
            android:authorities="${applicationId}.downloads"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The player for the Stremio add-ons' channels, in a process of its own: a stream that hangs or a decoder
             that crashes can't take the home screen with it. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:process=":player"
            android:supportsPictureInPicture="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Scripts from elsewhere, each kind in a process of its own: one that loops forever or crashes takes only
             its process with it, which is killed and started again (see ScriptProcess). -->
        <service android:name=".PluginService" android:exported="false" android:process=":plugins" />
        <service android:name=".ExtensionService" android:exported="false" android:process=":extensions" />

        <!-- The update installer reports here; not exported, so only Android (via Zephyr TV's PendingIntent) can. -->
        <receiver android:name=".InstallResult" android:exported="false" />

        <!-- Back to the home screen after an update (Android kills the old version, which uncovers the last app). -->
        <receiver android:name=".Updated" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Gallery screensaver; switched on and off from launcher settings. -->
        <service
            android:name=".GalleryDream"
            android:exported="true"
            android:label="@string/gallery"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Google TV's launcher must stay enabled; this service replaces it on screen whenever it shows. -->
        <service
            android:name=".HomeOverride"
            android:exported="false"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_override" />
        </service>
        <!-- Lets Zephyr TV see what's playing (media sessions) for the Play queue; it reads no notifications. -->
        <service
            android:name=".PlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
