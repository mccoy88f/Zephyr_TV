<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). Nothing clips the page to the screen
     height: the rows under the apps can run past the bottom edge, and the page slides up to show them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">
        <!-- Bottom is a little more than the top: the last text line's box includes space under the letters,
             so this makes the visible gap below Continue Watching match the gap above the clock. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textSize="30sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:format12Hour="EEE d MMM"
                    android:format24Hour="EEE d MMM"
                    android:textSize="15sp" />

                <!-- "14° Cloudy · Paris". Off unless turned on in launcher settings. -->
                <TextView
                    android:id="@+id/weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Who's watching (see Users): their Continue Playing, ✓ marks and Trakt account. -->
            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/usersButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/users_title"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_profile" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/searchButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/search_title"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_search" />

            <!-- The downloads (see DownloadsUi): there once something is downloaded, red-dotted while one goes. -->
            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/downloadsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/download"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_download"
                android:visibility="gone" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/wifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/network_settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_wifi" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/allAppsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/all_apps"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_apps" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/tvInputsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tv_inputs"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_input" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/systemSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

            <link.mccoy88f.zephyr.HaloImageView
                android:id="@+id/launcherSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/plume_settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- TMDB Spotlight hero panel: shown when enabled, expands on D-pad UP from app row -->
        <LinearLayout
            android:id="@+id/spotlightContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Faint arrows either side say there are more titles; they sit in the page margins so the
                 text stays lined up with the apps row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/spotlightPrev"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-32dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.35"
                    android:contentDescription="@string/spotlight_previous"
                    android:src="@drawable/ic_chevron_left" />

                <LinearLayout
                    android:id="@+id/spotlightInfoBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/spotlightMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/spotlightTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/spotlightOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.85"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="3"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/spotlightNext"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="-32dp"
                    android:alpha="0.35"
                    android:contentDescription="@string/spotlight_next"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Action buttons directly under info box, independently focusable -->
            <LinearLayout
                android:id="@+id/spotlightActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The room between Spotlight and the apps, which keeps the apps low; closed while Spotlight is folded away
             (see foldSpotlight), so the apps go up under the top bar. -->
        <View
            android:id="@+id/spotlightGap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Apps, then a row per section of the focused app's recommendations. Only the apps and the first
             section set its height (the apps row stays put); further sections hang below, see BottomSection. -->
        <link.mccoy88f.zephyr.BottomSection
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Only shown while editing the row (it carries the instructions). -->
            <TextView
                android:id="@+id/appsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Both rows: the scroller reaches 16dp (one grid gap) past the content edges on each side and
                 clips there. That is room for the focus lift, while the next item, a gap away, stays hidden.
                 Same on left and right, and SnapScrollView scrolls by whole items. -->
            <link.mccoy88f.zephyr.SnapScrollView
                android:id="@+id/appScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="-24dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/appRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal" />

                    <!-- Name of the focused app, slid under its tile (tvOS style). In the scroll content, so it scrolls along. -->
                    <TextView
                        android:id="@+id/rowLabel"
                        android:layout_width="200dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:alpha="0"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textSize="13sp" />

                    <!-- "App names: Always": every name under its tile, in place of rowLabel (same space). -->
                    <LinearLayout
                        android:id="@+id/nameRow"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </LinearLayout>
            </link.mccoy88f.zephyr.SnapScrollView>

            <TextView
                android:id="@+id/watchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:fontFamily="sans-serif-medium"
                android:text="@string/continue_watching"
                android:textSize="14sp"
                android:visibility="gone" />

            <link.mccoy88f.zephyr.SnapScrollView
                android:id="@+id/watchScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginTop="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="-24dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/watchRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </link.mccoy88f.zephyr.SnapScrollView>

            <!-- Sections after the first: a title and a row each, built in code like the ones above. -->
            <LinearLayout
                android:id="@+id/moreSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </link.mccoy88f.zephyr.BottomSection>
    </LinearLayout>

    <!-- All apps: hidden until the Apps tile is pressed; Back closes it. Children unclipped, or the grid is cut
         to its own width and a focused tile in the first or last column loses the edge it lifts into the margin. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/all_apps"
                android:textSize="20sp" />

            <GridLayout
                android:id="@+id/allAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="6" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/plume_settings"
                android:textSize="20sp" />

            <!-- Scrolls once the rows outgrow the screen; focus moving down scrolls it along. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
