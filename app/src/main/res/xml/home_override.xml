<?xml version="1.0" encoding="utf-8"?>
<!--
  No flagRequestFilterKeyEvents here: HomeOverride.applyKeyFilter() turns it on when the service connects,
  unless Direct remote keys is on (filtering every key makes the remote lag on some TVs).
  canRequestFilterKeyEvents stays true so the filter can be switched without reinstalling.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/override_desc" />
