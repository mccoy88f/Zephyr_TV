# Copy to .env for a local run; on Coolify set these in the resource's Environment Variables.

# The database (the db service): its password is required.
POSTGRES_USER=ztv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ztv

# Where the site is reachable: links in emails and the share pages.
SITE_URL=https://ztv.mccoy88f.link

# The superadmin, created (or its password updated) each time the site starts.
SUPERADMIN_EMAIL=su@ztv.mccoy88f.link
SUPERADMIN_PASSWORD=change-me-too

# The releases shown on Download. A token (no scopes) only raises GitHub's rate limit.
GITHUB_REPO=mccoy88f/Zephyr_TV
GITHUB_TOKEN=
