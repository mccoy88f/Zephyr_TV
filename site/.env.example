# Copy to .env for a local run; on Coolify set these in the resource's Environment Variables.

# The database (the db service): its password is required.
POSTGRES_USER=ztv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ztv

# Where the site is reachable: links in emails and the share pages.
SITE_URL=https://ztv.mccoy88f.link

# The superadmin, created (or its password updated) each time the site starts.
SUPERADMIN_EMAIL=su@ztv.mccoy88f.link
SUPERADMIN_PASSWORD=change-me-too

# The releases shown on Download. A token (no scopes) only raises GitHub's rate limit.
GITHUB_REPO=mccoy88f/Zephyr_TV
GITHUB_TOKEN=

# Optional: previews of shared titles that have only a TMDB id (most have an IMDb one, which Cinemeta knows).
TMDB_API_KEY=

# Trakt's sign-in for Zephyr TV (/traktauth), with PKCE: no secret. The id defaults to Zephyr TV's app, which needs
# "Sign users in with PKCE" on and SITE_URL/traktauth among its redirect URIs (trakt.tv/oauth/applications).
TRAKT_CLIENT_ID=

# Email (sign-up confirmations, new passwords): OVH's shared SMTP, the sender's own mailbox.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=noreply@mccoy88f.link
SMTP_PASSWORD=

# Encrypts what the TVs sync (settings, add-ons, what each user watched) in the database. Any long random
# text (openssl rand -base64 32); keep it: changed, what was synced is lost (the TVs send it again).
SYNC_KEY=
MAIL_FROM=Zephyr TV <noreply@mccoy88f.link>
