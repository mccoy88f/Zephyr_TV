<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- A whole download keeps going in the foreground, with its notification (see DownloadService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Zephyr TV (and its debug build), whose signature the engine checks before answering (see EngineProvider). -->
    <queries>
        <package android:name="link.mccoy88f.zephyr" />
        <package android:name="link.mccoy88f.zephyr.debug" />
    </queries>

    <!-- No icon among the apps: Zephyr TV installs it, uses it, and removes it from its settings. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">

        <!-- Zephyr TV's way in (see EngineProvider): exported, answering only apps signed with this one's key. -->
        <provider
            android:name=".EngineProvider"
            android:authorities="${applicationId}.engine"
            android:exported="true" />

        <service
            android:name=".DownloadService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
